<UserControl x:Class="LaboratoireProgrammation.Project.ViewModels.Exercices.Exo2B3"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:colorhelper="clr-namespace:LaboratoireProgrammation.Project.Helpers"
             xmlns:local="clr-namespace:LaboratoireProgrammation.Project.ViewModels.Exercices"
             mc:Ignorable="d" Background="Transparent" d:DesignWidth="900" d:DesignHeight="550">

    <UserControl.Resources>
        <SolidColorBrush x:Key="TerminalYellowBrush" Color="{x:Static colorhelper:ColorHelper.FancyText}" />
        <SolidColorBrush x:Key="TerminalBgBrush" Color="#09090B" />
        <SolidColorBrush x:Key="TerminalPanelBrush" Color="#111113" />
        <SolidColorBrush x:Key="TerminalBorderBrush" Color="#2A2A2E" />
        <FontFamily x:Key="TerminalFont">Consolas</FontFamily>

        <local:TaskStateColorConverter x:Key="TaskStateColorConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="TerminalBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TerminalYellowBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource TerminalFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,5,0,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{StaticResource TerminalBorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1A1C" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TerminalYellowBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource TerminalYellowBrush}" />
                                <Setter Property="Foreground" Value="Black" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TerminalTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1A1C" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource TerminalBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource TerminalFont}" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="0,5,0,15" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource TerminalBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource TerminalPanelBrush}"
                BorderBrush="{StaticResource TerminalBorderBrush}" BorderThickness="0,0,1,0" Padding="15">
            <StackPanel>
                <TextBlock Text="[ TO-DO LIST ]" FontFamily="pack://application:,,,/Assets/fonts/#Doto" FontSize="28"
                           FontWeight="Bold" Foreground="{StaticResource TerminalYellowBrush}" Margin="0,0,0,25" />

                <TextBlock Text="Nouvelle tâche :" FontFamily="{StaticResource TerminalFont}" Foreground="#A0A0A0" FontSize="12" />
                <TextBox x:Name="TxtNewTask" Style="{StaticResource TerminalTextBox}" Height="28" />

                <TextBlock Text="Priorité :" FontFamily="{StaticResource TerminalFont}" Foreground="#A0A0A0" FontSize="12" />
                <ComboBox x:Name="CmbPriority" Margin="0,5,0,20" Background="#1A1A1C" Foreground="Black" FontFamily="{StaticResource TerminalFont}" SelectedIndex="1">
                    <ComboBoxItem Content="Basse" />
                    <ComboBoxItem Content="Normale" />
                    <ComboBoxItem Content="Haute" />
                </ComboBox>

                <Button x:Name="BtnAdd" Style="{StaticResource TerminalBtn}" Content="Ajouter" Click="BtnAdd_Click" />
                <Button x:Name="BtnDelete" Style="{StaticResource TerminalBtn}" Content="Supprimer" Click="BtnDelete_Click" Foreground="#FF5E5E" />
                
                <Rectangle Height="1" Fill="{StaticResource TerminalBorderBrush}" Margin="0,20" />
                
                <Button x:Name="BtnSave" Style="{StaticResource TerminalBtn}" Content="Enregistrer" Click="BtnSave_Click" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="[ RECHERCHE ]" FontFamily="pack://application:,,,/Assets/fonts/#Doto" FontSize="16" Foreground="{StaticResource TerminalYellowBrush}" VerticalAlignment="Center" Margin="0,0,15,0" />
                <TextBox x:Name="TxtSearch" Grid.Column="1" Style="{StaticResource TerminalTextBox}" Margin="0" TextChanged="TxtSearch_TextChanged" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <TextBlock x:Name="LblProgress" Text="Progression : 0%" FontFamily="{StaticResource TerminalFont}" Foreground="#A0A0A0" FontSize="12" Margin="0,0,0,5" />
                <ProgressBar x:Name="PrgTasks" Height="4" Minimum="0" Maximum="100" Value="0" Background="#1A1A1C" Foreground="{StaticResource TerminalYellowBrush}" BorderThickness="0" />
            </StackPanel>

            <ListBox x:Name="LstTasks" Grid.Row="2" Background="Transparent" BorderThickness="0" 
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Margin" Value="0,2,0,2" />
                        <Setter Property="Padding" Value="5" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource TerminalBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#1A1A1C" />
                                            <Setter Property="BorderBrush" Value="{StaticResource TerminalYellowBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox IsChecked="{Binding IsDone, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,0" Checked="Task_StateChanged" Unchecked="Task_StateChanged" />

                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <TextBox Text="{Binding Titre, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="Transparent" BorderThickness="0" 
                                         FontFamily="{StaticResource TerminalFont}" FontSize="14"
                                         Foreground="{Binding IsDone, Converter={StaticResource TaskStateColorConverter}}" />
                                
                                <Rectangle Height="1" Fill="Gray" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,2,0,0"
                                           Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}" IsHitTestVisible="False" />
                            </Grid>

                            <Border Grid.Column="2" Background="#2A2A2E" CornerRadius="3" Padding="8,2" Margin="10,0,0,0">
                                <TextBlock Text="{Binding Priority}" FontFamily="{StaticResource TerminalFont}" FontSize="10" Foreground="#A0A0A0" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </Grid>
    </Grid>
</UserControl>
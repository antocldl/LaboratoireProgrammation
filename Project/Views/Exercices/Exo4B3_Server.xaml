<UserControl x:Class="LaboratoireProgrammation.Project.Views.Exercices.Exo4B3_Server"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LaboratoireProgrammation.Project.Views.Exercices"
             xmlns:colorhelper="clr-namespace:LaboratoireProgrammation.Project.Helpers"
             mc:Ignorable="d" Background="Transparent"
             d:DesignHeight="auto" d:DesignWidth="auto">
    
    <UserControl.Resources>
        <SolidColorBrush x:Key="TerminalYellowBrush" Color="{x:Static colorhelper:ColorHelper.FancyText}" />
        <SolidColorBrush x:Key="TerminalBgBrush" Color="#09090B" />
        <SolidColorBrush x:Key="TerminalPanelBrush" Color="#111113" />
        <SolidColorBrush x:Key="TerminalBorderBrush" Color="#2A2A2E" />
        <FontFamily x:Key="TerminalFont">Consolas</FontFamily>
        
        <Style x:Key="TerminalTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0A0A0A" />
            <Setter Property="Foreground" Value="{StaticResource TerminalYellowBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TerminalYellowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource TerminalYellowBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource TerminalFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0A0A0A" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TerminalYellowBrush}" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0A0A0A" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TerminalYellowBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>
    
    <Grid>
        
        <StackPanel>
            
            <TextBox x:Name="TxtSender" Style="{StaticResource TerminalTextBox}" Margin="0,0,0,10" />
            
            <Border Grid.Column="2" Background="#0A0A0A" Margin="0,0,0,0"
                    BorderBrush="{x:Static colorhelper:ColorHelper.FancyTextBrush}" BorderThickness="1"
                    CornerRadius="0" Padding="20" Width="auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="> Server Console" 
                               FontFamily="pack://application:,,,/Assets/fonts/#ubuntu mono" FontSize="14"
                               Foreground="{x:Static colorhelper:ColorHelper.FancyTextBrush}" Opacity="0.4" Margin="0,0,0,20"/>
                    <RichTextBox Grid.Row="1" Background="Transparent" BorderBrush="Transparent"></RichTextBox>
                </Grid>
            </Border>
            
        </StackPanel>
        
    </Grid>
</UserControl>

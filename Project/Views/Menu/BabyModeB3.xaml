<UserControl x:Class="LaboratoireProgrammation.Project.ViewModels.Menu.BabyModeB3"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:colorhelper="clr-namespace:LaboratoireProgrammation.Project.Helpers"
             mc:Ignorable="d"
             Background="Transparent">

    <UserControl.Resources>
        <Color x:Key="AccentColor">#3DD68C</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <FontFamily x:Key="TerminalFont">Consolas</FontFamily>

        <Style x:Key="TerminalCard" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="GlowBorder"
                                    Margin="-4"
                                    Background="Transparent"
                                    Opacity="0"
                                    CornerRadius="2">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="GlowEffect"
                                                      Color="{StaticResource AccentColor}"
                                                      ShadowDepth="0"
                                                      BlurRadius="18"
                                                      Opacity="0.85" />
                                </Border.Effect>
                            </Border>

                            <Border x:Name="CardBody"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Border x:Name="FillLayer"
                                            HorizontalAlignment="Left"
                                            Width="0"
                                            Background="{StaticResource AccentBrush}"
                                            Opacity="0.15" />
                                    <ContentPresenter />
                                </Grid>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="FillLayer"
                                                Storyboard.TargetProperty="Width"
                                                To="1200" Duration="0:0:0.25"
                                                EasingFunction="{x:Null}" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="FillLayer"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0.18" Duration="0:0:0.2" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="GlowBorder"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1" Duration="0:0:0.2" />
                                            <ColorAnimation
                                                Storyboard.TargetName="CardBody"
                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                To="White" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="FillLayer"
                                                Storyboard.TargetProperty="Width"
                                                To="0" Duration="0:0:0.2" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="FillLayer"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0.12" Duration="0:0:0.2" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="GlowBorder"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0" Duration="0:0:0.25" />
                                            <ColorAnimation
                                                Storyboard.TargetName="CardBody"
                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                To="{StaticResource AccentColor}"
                                                Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FillLayer" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="0,0,15,0">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Width="1200" Margin="0,20,0,20">

            <StackPanel Margin="0,0,0,28">
                <TextBlock Text=":// MODE VISUEL - BLOC 3 | SÉLECTIONNEZ UN MODULE :\\"
                           FontFamily="pack://application:,,,/Assets/fonts/#ubuntu mono"
                           FontSize="24"
                           Foreground="{StaticResource AccentBrush}"
                           Opacity="0.5"
                           HorizontalAlignment="Left" />
                <Rectangle Height="1" Fill="{StaticResource AccentBrush}" Opacity="0.2"
                           Margin="0,6,0,0" />
            </StackPanel>

            <Grid Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,8,0,10" Grid.Row="0">
                    <TextBlock Text=":// Exercices"
                               FontFamily="pack://application:,,,/Assets/fonts/#ubuntu mono" FontSize="20"
                               Foreground="{StaticResource AccentBrush}"
                               Opacity="0.35" HorizontalAlignment="Left" />

                    <Rectangle Height="1" Fill="{StaticResource AccentBrush}" Opacity="0.12"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Row="1" Style="{StaticResource TerminalCard}"
                        Click="Exo1B3" MinHeight="120">
                    <Grid Margin="20,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="[Exercice 1 - B3] >>> HOOT-LOUK"
                                   FontFamily="pack://application:,,,/Assets/fonts/#Doto"
                                   FontSize="38" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" />

                        <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource AccentBrush}"
                                   Opacity="0.25" Margin="0,6,0,8" />

                        <TextBlock Grid.Row="2"
                                   Text="Client de messagerie complet avec éditeur RTF, mise en forme avancée, gestion des destinataires et expédition SMTP."
                                   FontFamily="Consolas" FontSize="13"
                                   Foreground="{StaticResource AccentBrush}"
                                   Opacity="0.55" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="3" Text="[ LANCER ]"
                                   FontFamily="Consolas" FontSize="16.5" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Opacity="0.4" HorizontalAlignment="Right"
                                   Margin="0,6,0,0" />
                    </Grid>
                </Button>
                
                <Button Grid.Row="2" Style="{StaticResource TerminalCard}" Margin="0,20,0,0"
                        Click="Exo2B3" MinHeight="120">
                    <Grid Margin="20,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="[Exercice 2 - B3] >>> T.ODOO"
                                   FontFamily="pack://application:,,,/Assets/fonts/#Doto"
                                   FontSize="38" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" />

                        <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource AccentBrush}"
                                   Opacity="0.25" Margin="0,6,0,8" />

                        <TextBlock Grid.Row="2"
                                   Text="Une application client de rappel, de to-do list."
                                   FontFamily="Consolas" FontSize="13"
                                   Foreground="{StaticResource AccentBrush}"
                                   Opacity="0.55" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="3" Text="[ LANCER ]"
                                   FontFamily="Consolas" FontSize="16.5" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Opacity="0.4" HorizontalAlignment="Right"
                                   Margin="0,6,0,0" />
                    </Grid>
                </Button>
            </Grid>

            <StackPanel Margin="0,24,0,0">
                <Rectangle Height="1" Fill="{StaticResource AccentBrush}" Opacity="0.12" />
                <TextBlock Text="@anto.cldl : Terminal.UI v1.0  |  MODE VISUEL BLOC 3 ACTIF"
                           FontFamily="pack://application:,,,/Assets/fonts/#ubuntu mono" FontSize="16"
                           Foreground="{StaticResource AccentBrush}"
                           Opacity="0.4" HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
<UserControl x:Class="LaboratoireProgrammation.Project.ViewModels.Menu.VisualSelectorB3"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:colorhelper="clr-namespace:LaboratoireProgrammation.Project.Helpers"
             mc:Ignorable="d"
             Background="Transparent">

    <UserControl.Resources>

        <Style x:Key="TerminalCard" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{x:Static colorhelper:ColorHelper.SnowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="GlowBorder"
                                    Margin="-4"
                                    Background="Transparent"
                                    Opacity="0"
                                    CornerRadius="2">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="GlowEffect"
                                                      Color="{x:Static colorhelper:ColorHelper.Snow}"
                                                      Opacity="0.85" />
                                </Border.Effect>
                            </Border>

                            <Border x:Name="CardBody"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Border x:Name="FillLayer"
                                            HorizontalAlignment="Left"
                                            Width="0"
                                            Background="{x:Static colorhelper:ColorHelper.SnowBrush}"
                                            Opacity="0.15" />
                                    <ContentPresenter />
                                </Grid>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="FillLayer"
                                                Storyboard.TargetProperty="Width"
                                                To="1200" Duration="0:0:0.25"
                                                EasingFunction="{x:Null}" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="FillLayer"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0.18" Duration="0:0:0.2" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="GlowBorder"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1" Duration="0:0:0.2" />
                                            <ColorAnimation
                                                Storyboard.TargetName="CardBody"
                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                To="White" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="FillLayer"
                                                Storyboard.TargetProperty="Width"
                                                To="0" Duration="0:0:0.2" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="FillLayer"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0.12" Duration="0:0:0.2" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="GlowBorder"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0" Duration="0:0:0.25" />
                                            <ColorAnimation
                                                Storyboard.TargetName="CardBody"
                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                To="{x:Static colorhelper:ColorHelper.Snow}"
                                                Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FillLayer" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="0,0,15,0">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="1200" Margin="0,20,0,20">
            
                <MediaElement x:Name="FogPlayer1" 
                  Source="pack://siteoforigin:,,,/Assets/Backgrounds/MP4/BackgroundFog1.mp4" 
                  LoadedBehavior="Play" 
                  UnloadedBehavior="Manual"
                  Stretch="UniformToFill"
                  Opacity="0.15" 
                  MediaEnded="MyVideoPlayer_MediaEnded" />
            
    <MediaElement x:Name="FogPlayer2" 
                  Source="pack://siteoforigin:,,,/Assets/Backgrounds/MP4/BackgroundFog2.mp4" 
                  LoadedBehavior="Play" 
                  UnloadedBehavior="Manual"
                  Stretch="UniformToFill"
                  Opacity="0.15" 
                  MediaEnded="MyVideoPlayer_MediaEnded" />

            <Button Style="{StaticResource TerminalCard}" Click="Exo2" MinHeight="40" Margin="0,0,0,10">
                <Grid Margin="20,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="• [anto.cldl] >>> git.cldl"
                               FontFamily="pack://application:,,,/Assets/fonts/#jetbrains"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{x:Static colorhelper:ColorHelper.SnowBrush}" />
                </Grid>
            </Button>
            
        </StackPanel>
    </ScrollViewer>
</UserControl>